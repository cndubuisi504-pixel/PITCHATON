# ============================================================================
# PITCHATON — environment template
# ============================================================================
# Copy to .env.local  →  cp .env.local.example .env.local
#
# NOTHING here is required to run locally: with no variables set the platform
# boots on the built-in local file store (.data/db.json) so you can click
# through every feature immediately. Add Supabase when you are ready to go
# live — the storage driver switches automatically.
# ============================================================================

# ---------------------------------------------------------------------------
# 1. Supabase (production database + file storage)  — free tier
#    Dashboard → Project Settings → API
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
# "anon public" key — safe to expose, used only for browser-side utilities
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# "service_role" secret — SERVER ONLY. Never expose, never commit.
SUPABASE_SERVICE_ROLE_KEY=
# Storage bucket that holds pitch attachments (created by supabase-schema.sql)
SUPABASE_STORAGE_BUCKET=pitch-files

# ---------------------------------------------------------------------------
# 2. Security
# ---------------------------------------------------------------------------
# Signs the session JWT. Generate one:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Without it the app still runs, but sessions reset on every redeploy.
SESSION_SECRET=

# Accounts that are ALWAYS admins (comma separated). The Hub address is the
# default; add a second organiser here if you like.
ADMIN_EMAILS=contacteihpitchaton@gmail.com

# The code every other admin must enter once, on the signup form.
# Change this before the site is public.
ADMIN_ACCESS_CODE=PITCHATON-ADMIN

# ---------------------------------------------------------------------------
# 3. Email notifications (Resend free tier — 3,000 emails/month, no card)
#    https://resend.com → API Keys
# ---------------------------------------------------------------------------
RESEND_API_KEY=
# Leave as-is until you verify your own domain in Resend.
EMAIL_FROM=PITCHATON <onboarding@resend.dev>
# Optional: where admin alerts (new submission) are delivered.
EMAIL_ADMIN_FROM=
# Optional dev safety net: send every email here instead of the real inbox.
EMAIL_DEV_OVERRIDE=

# ---------------------------------------------------------------------------
# 4. Site details (safe to expose, used in metadata and emails)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_HUB_NAME=ICT Hub
NEXT_PUBLIC_INSTITUTION_NAME=ICT Hub · Enugu, Nigeria

# Optional: relocate the local file store (defaults to ./.data)
# PITCHATON_DATA_DIR=
