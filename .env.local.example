# ============================================================================
# PITCHATON — environment template
# ============================================================================
# Copy to .env.local  →  cp .env.local.example .env.local
#
# NOTHING here is required to run locally: with no variables set the platform
# boots on the built-in local file store (.data/db.json) so you can click
# through every feature immediately. Add Supabase when you are ready to go
# live — the storage driver switches automatically.
# ============================================================================

# ---------------------------------------------------------------------------
# 1. Supabase (production database + file storage)  — free tier
#    Dashboard → Project Settings → API keys
#
#    In production (Netlify) these three are REQUIRED: Netlify's filesystem is
#    read-only and ephemeral, so without them the app falls back to the local
#    file store and nothing persists. Add them in
#    Netlify → Site configuration → Environment variables — never in a file.
#
#    Run supabase-schema.sql once (fresh project) or supabase-migrate.sql
#    (existing project) in the Supabase SQL editor, then verify with:
#       npm run check:supabase      (or open /api/health while signed in)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
# Publishable / "anon public" key — safe to expose, browser-side utilities only
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret / "service_role" key — SERVER ONLY. Never expose, never commit.
# The publishable key does NOT work here; /api/health will say "Invalid API key".
SUPABASE_SERVICE_ROLE_KEY=
# Storage bucket that holds pitch attachments (created by the SQL; PRIVATE —
# downloads go through /api/files/:id which issues a 120-second signed URL)
SUPABASE_STORAGE_BUCKET=pitch-files

# ---------------------------------------------------------------------------
# 2. Security
# ---------------------------------------------------------------------------
# Signs the session JWT. Generate one:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Without it the app still runs, but sessions reset on every redeploy.
SESSION_SECRET=

# Accounts that are ALWAYS admins (comma separated). The Hub address is the
# default; add a second organiser here if you like.
ADMIN_EMAILS=contacteihpitchaton@gmail.com

# The code another organiser must enter once, on the signup form, to become an
# admin. There is no default: leave it blank and ONLY the addresses above can
# hold admin rights. Set a random value before inviting a second organiser.
#   node -e "console.log('HUB-' + require('crypto').randomBytes(9).toString('hex'))"
ADMIN_ACCESS_CODE=

# ---------------------------------------------------------------------------
# 3. Email notifications (Resend free tier — 3,000 emails/month, no card)
#    https://resend.com → API Keys
# ---------------------------------------------------------------------------
RESEND_API_KEY=
# Leave as-is until you verify your own domain in Resend.
EMAIL_FROM=PITCHATON <onboarding@resend.dev>
# Optional: where admin alerts (new submission) are delivered.
EMAIL_ADMIN_FROM=
# Optional dev safety net: send every email here instead of the real inbox.
EMAIL_DEV_OVERRIDE=

# ---------------------------------------------------------------------------
# 4. Site details (safe to expose, used in metadata and emails)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_HUB_NAME=ICT Hub
NEXT_PUBLIC_INSTITUTION_NAME=ICT Hub · Enugu, Nigeria

# Optional: relocate the local file store (defaults to ./.data)
# PITCHATON_DATA_DIR=
